{
  "name": "photopop",
  "version": "0.1.0-alpha.1",
  "description": "A local-first, open-source desktop image editor for design professionals.",
  "author": "PhotoPop Contributors",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.mjs\"",
    "desktop": "electron electron/main.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "build:desktop": "pnpm build && electron-builder --win nsis portable zip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:e2e:windows": "playwright test --config playwright.electron.config.mts",
    "benchmark:reference": "node scripts/performance-reference.mjs --assert --output artifacts/performance-reference.json",
    "generate:assets": "node scripts/generate-brand-assets.mjs",
    "generate:samples": "node scripts/create-sample-project.mjs",
    "verify": "pnpm test && pnpm build && pnpm test:sites",
    "verify:release": "pnpm verify && pnpm benchmark:reference && pnpm test:e2e:windows"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tabler/icons-react": "3.49.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ag-psd": "31.0.3",
    "canvaskit-wasm": "0.42.0",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "org.photopop.editor",
    "productName": "PhotoPop",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "photopop",
        "name": "PhotoPop Project",
        "description": "PhotoPop layered image project",
        "mimeType": "application/x-photopop",
        "role": "Editor"
      }
    ],
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "README.md",
      "ASSETS.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
